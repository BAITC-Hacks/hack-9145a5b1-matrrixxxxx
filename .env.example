# Получите токен у @BotFather. Никогда не добавляйте реальный токен в Git.
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_BOT_USERNAME=CareerQuestRemindBot

# Защищает ручной запуск /api/reminders/run (длинная случайная строка).
CRON_SECRET=replace_with_a_long_random_value

# Telegram добавляет этот заголовок к webhook-запросу, если секрет задан.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_different_long_random_value

# PORT=4173

# Только для локальной разработки API v1. В production заменяется корпоративным SSO.
CAREER_QUEST_DEV_AUTH=false
